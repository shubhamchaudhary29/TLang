import config
import db
import http
import json
import strings

config.load()

let connection be db.open(config.require("DATABASE_URL"), {
    username: config.require("DATABASE_USER"),
    password: config.require("DATABASE_PASSWORD"),
    poolSize: 10,
    connectionTimeoutMs: 5000,
    queryTimeoutSeconds: 15
})

connection.migrate("examples/postgres-api/migrations")

let notes be connection.table("notes")

let server be http.server(strings.toNumber(config.getOr("PORT", "8080")))

define createNote taking req and res
    let payload be json.parse(req.body)
    let affected be notes.insert({content: payload.content})
    res.status(201).json({affected: affected})

define listNotes taking req and res
    res.json(notes.orderBy("id", "asc").limit(100).all())

define getNote taking req and res
    let note be notes.where("id", "=", strings.toNumber(req.params.id)).first()
    res.json(note)

define updateNote taking req and res
    let payload be json.parse(req.body)
    let tx be connection.begin()
    let selected be tx.table("notes").where("id", "=", strings.toNumber(req.params.id))
    selected.update({content: payload.content})
    let note be selected.first()
    tx.commit()
    res.json(note)

define deleteNote taking req and res
    let affected be notes.where("id", "=", strings.toNumber(req.params.id)).delete()
    res.json({affected: affected})

server.get("/notes/:id", getNote)
server.put("/notes/:id", updateNote)
server.delete("/notes/:id", deleteNote)
server.post("/notes", createNote)
server.get("/notes", listNotes)

show "PostgreSQL notes API listening on http://127.0.0.1:" + config.getOr("PORT", "8080")
server.start()
